<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.joshtune.mx-workflow-slack-bot</string>

  <!-- Use wrapper script that sources .env -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/YOUR_USERNAME/mx-workflow/slack-bot/start.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/YOUR_USERNAME/mx-workflow/slack-bot</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/YOUR_USERNAME</string>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
  </dict>

  <!-- Log stdout and stderr to files -->
  <key>StandardOutPath</key>
  <string>/Users/YOUR_USERNAME/builds/.logs/slack-bot.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USERNAME/builds/.logs/slack-bot-error.log</string>

  <!-- Auto-restart if it crashes -->
  <key>KeepAlive</key>
  <true/>

  <!-- Start on login -->
  <key>RunAtLoad</key>
  <true/>

  <!-- Throttle restarts to avoid crash loop -->
  <key>ThrottleInterval</key>
  <integer>10</integer>
</dict>
</plist>
