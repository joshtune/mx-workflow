# ── Slack Bot Credentials ────────────────────────────────────────────────────
# Get these from https://api.slack.com/apps → your app → OAuth & Permissions

# Bot User OAuth Token (starts with xoxb-)
SLACK_BOT_TOKEN=xoxb-your-token-here

# Signing Secret (from Basic Information page)
SLACK_SIGNING_SECRET=your-signing-secret-here

# App-Level Token for Socket Mode (starts with xapp-)
# Create at: Basic Information → App-Level Tokens → Generate Token with connections:write scope
SLACK_APP_TOKEN=xapp-your-app-token-here

# Bot's own User ID — get this by calling auth.test after installing the app
# Or find it in Slack: right-click your bot → View profile → More → Copy member ID
SLACK_BOT_USER_ID=U0XXXXXXXXX

# ── Channel Config ────────────────────────────────────────────────────────────
# Name of the channel to listen for build instructions (no # prefix)
SLACK_BUILDS_CHANNEL=builds

# ── mx-workflow paths ─────────────────────────────────────────────────────────
# Where your mx-workflow plugin is cloned
MX_PLUGIN_DIR=/Users/your-username/mx-workflow

# Where build sessions are created (each build gets its own subdirectory)
MX_WORK_DIR=/Users/your-username/builds

# Where session logs are stored
MX_LOG_DIR=/Users/your-username/builds/.logs
