# mx-workflow plugin configuration
# Copy to your shell profile or set in ~/.claude/settings.json under "env"

# Ticket reference prefix used in conventional commit messages
# Example commit: feat(auth)[PROJ-1234] add token refresh
# Leave empty if you don't use ticket references in commits
MX_TICKET_PREFIX=

# Regex pattern to extract ticket number from branch name
# Must capture the ticket number after \K (PCRE lookbehind)
# Example: for branches like "feature/alice/12345-description", use "feature/[^/]+/"
# Leave empty if you don't encode ticket numbers in branch names
MX_BRANCH_PATTERN=

# Co-author line appended to AI-assisted commits
# Default: Claude <noreply@anthropic.com>
# MX_CO_AUTHOR=Claude <noreply@anthropic.com>
