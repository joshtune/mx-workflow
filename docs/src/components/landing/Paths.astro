---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const paths = [
  {
    title: 'Review code now',
    time: '2 minutes',
    text: 'Install, then run one command on any branch, yours or an AI\'s.',
    cmd: '/mx:review',
    href: '/getting-started/',
    cta: 'Install and try it',
  },
  {
    title: 'Run a ticket end to end',
    time: 'One session',
    text: 'Research, plan, build, prove, and ship with evidence attached.',
    cmd: '/mx:feasibility',
    href: '/guides/verification-evidence/',
    cta: 'Follow the loop',
  },
  {
    title: 'Gate your CI',
    time: '10 minutes',
    text: 'A strict verdict with a machine-readable marker your pipeline can read.',
    cmd: '/mx:reject',
    href: '/commands/review-tier/',
    cta: 'See the gate',
  },
];
const jobs = [
  ['Review my changes', '/mx:review', '/commands/review/'],
  ['Review an AI-generated PR', '/mx:second-look', '/commands/review-tier/'],
  ['Check if a task is doable', '/mx:feasibility', '/commands/verification/'],
  ['Prove a change works', '/mx:verify', '/commands/verification/'],
  ['Find the cause of a bug', '/mx:rca', '/commands/implementation/'],
  ['Stop quality from slipping', '/mx:ratchet', '/commands/review-tier/'],
  ['Capture what we learned', '/mx:lesson', '/guides/lessons-learned/'],
  ['Go from idea to shipped code', '/mx:build', '/commands/planning-design/'],
];
---

<section class="paths" aria-labelledby="paths-title">
  <p class="eyebrow">Start where you are</p>
  <h2 id="paths-title">Pick a path.</h2>

  <div class="cards">
    {
      paths.map((p) => (
        <a class="card" href={`${base}${p.href}`}>
          <span class="time">{p.time}</span>
          <h3>{p.title}</h3>
          <p>{p.text}</p>
          <code>{p.cmd}</code>
          <span class="cta">{p.cta} →</span>
        </a>
      ))
    }
  </div>

  <h3 class="jobs-title">Or find a command by the job</h3>
  <ul class="jobs">
    {
      jobs.map(([job, cmd, href]) => (
        <li>
          <a href={`${base}${href}`}>
            <span class="job">{job}</span>
            <code>{cmd}</code>
          </a>
        </li>
      ))
    }
  </ul>
  <p class="all">
    <a href={`${base}/agents/catalog/`}>All 16 agents</a>
    <span aria-hidden="true">·</span>
    <a href={`${base}/guides/choosing-a-workflow/`}>Choosing a workflow</a>
    <span aria-hidden="true">·</span>
    <a href={`${base}/reference/changelog/`}>Changelog</a>
  </p>
</section>

<style>
  .paths { padding: clamp(2rem, 5vw, 3.5rem) 0; }
  .eyebrow {
    margin: 0 0 0.6rem;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sl-color-accent-high);
  }
  h2 { margin: 0; font-size: clamp(1.7rem, 3.4vw, 2.4rem); letter-spacing: -0.02em; line-height: 1.15; color: var(--sl-color-white); }

  .cards { margin-top: 2rem; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.85rem; }
  .card {
    display: flex;
    flex-direction: column;
    padding: 1.3rem 1.2rem 1.2rem;
    text-decoration: none;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.9rem;
    background: var(--sl-color-gray-6);
    transition: border-color 0.15s, transform 0.15s;
  }
  .card:hover { border-color: var(--sl-color-accent); transform: translateY(-2px); }
  .card:focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 2px; }
  .time { font-size: var(--sl-text-xs); font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--sl-color-gray-3); }
  .card h3 { margin: 0.5rem 0 0; font-size: var(--sl-text-xl); color: var(--sl-color-white); }
  .card p { margin: 0.5rem 0 0; font-size: var(--sl-text-sm); line-height: 1.5; color: var(--sl-color-gray-2); }
  .card code {
    align-self: flex-start;
    margin-top: 1rem;
    font-size: 0.78rem;
    padding: 0.12rem 0.45rem;
    color: var(--sl-color-accent-high);
    background: var(--sl-color-accent-low);
    border: 0;
    border-radius: 0.3rem;
  }
  .cta { margin-top: auto; padding-top: 1.1rem; font-size: var(--sl-text-sm); font-weight: 600; color: var(--sl-color-accent-high); }

  .jobs-title { margin: 3rem 0 0.9rem; font-size: var(--sl-text-lg); color: var(--sl-color-white); }
  .jobs { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 2rem; }
  .jobs a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.7rem 0.2rem;
    text-decoration: none;
    border-top: 1px solid var(--sl-color-hairline);
    transition: background 0.15s;
  }
  .jobs a:hover .job { color: var(--sl-color-white); }
  .jobs a:hover code { color: var(--sl-color-white); }
  .job { font-size: var(--sl-text-sm); color: var(--sl-color-gray-2); }
  .jobs code { font-size: 0.78rem; color: var(--sl-color-accent-high); background: none; border: 0; padding: 0; white-space: nowrap; }
  .all { margin: 1.4rem 0 0; display: flex; flex-wrap: wrap; gap: 0.6rem; font-size: var(--sl-text-sm); color: var(--sl-color-gray-3); }
  .all a { color: var(--sl-color-accent-high); font-weight: 600; text-decoration: none; }
  .all a:hover { text-decoration: underline; }

  @media (max-width: 62rem) { .cards { grid-template-columns: 1fr; } .jobs { grid-template-columns: 1fr; } }
</style>
