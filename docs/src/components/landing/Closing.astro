---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const stats = [
  ['16', 'agents'],
  ['38', 'commands'],
  ['MIT', 'licensed'],
  ['0', 'servers or databases'],
];
---

<section class="closing" aria-labelledby="closing-title">
  <ul class="stats">
    {stats.map(([n, label]) => <li><strong>{n}</strong><span>{label}</span></li>)}
  </ul>

  <div class="cta">
    <h2 id="closing-title">Install it. Run <code>/mx:review</code>.</h2>
    <p>Two commands in Claude Code, then point it at any branch.</p>
    <div class="actions">
      <a class="btn primary" href={`${base}/getting-started/`}>Get started</a>
      <a class="btn" href="https://github.com/joshtune/mx-workflow">Star on GitHub</a>
    </div>
  </div>
</section>

<style>
  .closing { padding: clamp(1.5rem, 4vw, 2.5rem) 0 clamp(2rem, 5vw, 3rem); }
  .stats {
    margin: 0;
    padding: 1.4rem 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-block: 1px solid var(--sl-color-hairline);
  }
  .stats li { display: flex; flex-direction: column; align-items: center; gap: 0.15rem; }
  .stats strong { font-size: clamp(1.6rem, 3.4vw, 2.2rem); letter-spacing: -0.02em; color: var(--sl-color-white); }
  .stats span { font-size: var(--sl-text-sm); color: var(--sl-color-gray-3); text-align: center; }

  .cta {
    margin-top: clamp(2rem, 5vw, 3rem);
    padding: clamp(1.8rem, 5vw, 3rem) 1.5rem;
    text-align: center;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 1rem;
    background:
      radial-gradient(60% 120% at 50% 0%, var(--sl-color-accent-low), transparent 70%),
      var(--sl-color-gray-6);
  }
  h2 { margin: 0; font-size: clamp(1.6rem, 3.2vw, 2.2rem); letter-spacing: -0.02em; color: var(--sl-color-white); }
  h2 code { font-size: 0.85em; color: var(--sl-color-accent-high); background: none; border: 0; padding: 0; }
  .cta p { margin: 0.7rem 0 0; color: var(--sl-color-gray-2); }
  .actions { margin-top: 1.4rem; display: flex; justify-content: center; flex-wrap: wrap; gap: 0.6rem; }
  .btn {
    display: inline-flex;
    padding: 0.65rem 1.2rem;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    text-decoration: none;
    color: var(--sl-color-white);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.6rem;
    transition: border-color 0.15s, filter 0.15s;
  }
  .btn:hover { border-color: var(--sl-color-gray-3); }
  .btn.primary { background: var(--sl-color-accent); border-color: var(--sl-color-accent); color: #fff; }
  .btn.primary:hover { filter: brightness(1.1); }
  .btn:focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 2px; }

  @media (max-width: 40rem) { .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 1.2rem; } }
</style>
